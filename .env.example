# =============================================================================
# HydroPulse Backend — Environment Configuration Template (.env.example)
# Copy to `.env` for local development or supply via container/systemd env vars.
# NEVER commit a real `.env` file or real secrets to Git!
# =============================================================================

# Runtime environment: dev | prod | test
HYDROPULSE_ENV=dev

# Server bind address and port
HYDROPULSE_HOST=0.0.0.0
HYDROPULSE_PORT=8000
HYDROPULSE_LOG_LEVEL=INFO

# Development auto-reload (MUST be false when HYDROPULSE_ENV=prod)
HYDROPULSE_RELOAD=true

# Explicit CORS allowed origins (comma-separated).
# Wildcard (*) is forbidden when HYDROPULSE_ENV=prod.
HYDROPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Optional anchored regex for rotating origins (e.g. Vercel Preview URLs). In prod it must start
# with ^https://, end with $, and must not match unrelated origins.
# HYDROPULSE_CORS_ORIGIN_REGEX=^https://hydropulse-[a-z0-9-]+-yourteam[.]vercel[.]app$

# Administrative authentication boundary for mutating endpoints:
# (/api/ai/apply-suggestion, /api/network/import/commit, /api/network/build/commit,
#  /api/network/reset, /api/iot/ingest, /api/iot/auto-valve)
# When true, requests must send `Authorization: Bearer <token>` or `X-Admin-Token: <token>`.
HYDROPULSE_REQUIRE_ADMIN_AUTH=false
HYDROPULSE_ADMIN_TOKEN=

# Optional disk persistence for active mutated network state across restarts
HYDROPULSE_PERSIST_ACTIVE_STATE=false
HYDROPULSE_STATE_DIR=backend/.state

# Maximum HTTP request payload size in bytes (default: 2621440 = 2.5 MB)
HYDROPULSE_MAX_REQUEST_BYTES=2621440

# Network data paths (relative to repo root or absolute)
HYDROPULSE_INP=backend/bangalore_kengeri.inp
HYDROPULSE_META=backend/network_meta.json
HYDROPULSE_PRESETS=data_utils/presets.json

# =============================================================================
# OpenRouter Exclusive AI Gateway (Optional Server-Side Narrative Enrichment)
# Core hydraulic physics, triangulation, What-If, and AI Advisor calculations
# are 100% deterministic and work offline when OpenRouter is disabled/unset.
# =============================================================================
HYDROPULSE_OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
HYDROPULSE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
HYDROPULSE_OPENROUTER_TIMEOUT_S=4.0
HYDROPULSE_OPENROUTER_CONNECT_TIMEOUT_S=2.0
HYDROPULSE_OPENROUTER_MAX_RETRIES=1
