# Install as /etc/hydropulse/hydropulse.env. The installed file MUST be owned by
# root and mode 0600. This template contains non-secret production settings only.
# Add any required secret values directly to that installed file; never commit them.

HYDROPULSE_ENV=prod
HYDROPULSE_HOST=127.0.0.1
HYDROPULSE_PORT=8000
HYDROPULSE_LOG_LEVEL=INFO
HYDROPULSE_RELOAD=false

# Replace this with the exact HTTPS origin serving the UI before deployment.
# The .invalid placeholder is explicit and fail-closed: no real browser origin matches it.
# Never use a wildcard (*) in production.
HYDROPULSE_CORS_ORIGINS=https://replace-with-exact-frontend-origin.invalid

HYDROPULSE_CACHE_DIR=/var/lib/hydropulse
HYDROPULSE_STATE_DIR=/var/lib/hydropulse
HYDROPULSE_PERSIST_ACTIVE_STATE=true
HYDROPULSE_REQUIRE_ADMIN_AUTH=true
# Add HYDROPULSE_ADMIN_TOKEN with a strong secret (at least 8 characters) in the installed file.
HYDROPULSE_ADMIN_TOKEN=REPLACE_WITH_STRONG_SECRET_MIN_8_CHARS
HYDROPULSE_DOCS_ENABLED=false
HYDROPULSE_MAX_REQUEST_BYTES=2621440
